name = "aphrodite-edge"
main = "src/private-worker.ts"
compatibility_date = "2026-10-03"
compatibility_flags = ["global_fetch_strictly_public"]

[[d1_databases]]
binding = "DB"
database_name = "aphrodite-db"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
PUBLIC_EDGE_HOST = "smart.dr-mirhadi.ir"
EDGE_ROTATION_MINUTES = "60"
# Optional verified tuples: [{"address":"203.0.113.10","sni":"edge.example.com","host":"edge.example.com"}]
# EDGE_ENDPOINTS_JSON = '[]'
CONTROL_PLANE_ORIGIN = "https://panel.example.com"
BACKUP_ORIGINS = "https://backup-panel.example.com"
PUBLIC_CACHE_SECONDS = "120"
PROFILE_UPDATE_INTERVAL = "6"
TUNNEL_RACE_WIDTH = "2"
TUNNEL_CONNECT_TIMEOUT_MS = "4500"
TUNNEL_COOLDOWN_SECONDS = "30"
TUNNEL_ROUTES_JSON = '''
{
  "/edge/smart": [{"origin":"https://panel.example.com","path":"/smart-path"}],
  "/edge/us": [{"origin":"https://panel.example.com","path":"/us-path"}]
}
'''

# Set secrets separately:
# wrangler secret put ADMIN_TOKEN
# wrangler secret put CONTROL_PLANE_TOKEN
# Or use CONTROL_PLANE_USERNAME and CONTROL_PLANE_PASSWORD instead of a token.

# Configure a stable private management path: node scripts/setup-private.mjs
