name = "aphrodite-account-state"
main = "src/state-worker.ts"
compatibility_date = "2026-10-03"

[[durable_objects.bindings]]
name = "ACCOUNT_STATE"
class_name = "AccountState"

[[migrations]]
tag = "state-v1"
new_sqlite_classes = ["AccountState"]

