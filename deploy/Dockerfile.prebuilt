FROM node:24-bookworm-slim
WORKDIR /app
RUN mkdir /data && chown node:node /data
COPY . /app/
USER node
ENV PORT=8080 DATA_DIR=/data NATIVE_ENABLED=true NODE_NO_WARNINGS=1
EXPOSE 8080
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s CMD node -e "fetch('http://127.0.0.1:8080/'+process.env.ADMIN_PATH+'/api/overview',{headers:{Authorization:'Bearer '+process.env.ADMIN_TOKEN}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node","server.mjs"]
